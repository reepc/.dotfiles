# === Remote ===
shell-integration-features = ssh-terminfo,ssh-env, no-cursor

# === Font ===
font-family = "CaskaydiaMono Nerd Font Mono"
font-size = 14
font-thicken=true

# Push the underline to the bottom of the cell. indent-blankline.nvim draws the
# scope start/end as a real terminal underline; by default it sits near the text
# baseline, leaving a gap above the ▎ indent guide so the scope "corner" looks
# broken. A positive value moves the underline DOWN (negative = up); % is of cell
# height. Tune this until the scope underline meets the vertical guide cleanly.
# NOTE: this is global — it moves EVERY underline (links, spell, underlined text).
adjust-underline-position = 25%

# === Styling ===
theme = "Atom One Dark"
background = #282c34
window-padding-x = 10
window-padding-y = 10
# background-opacity = 0.90


# === Windows ===
window-new-tab-position = end
window-save-state = always


# === Clipboard ===
copy-on-select = clipboard

# === Cursor ===
cursor-style = block

# === Cursor smear (GPU shader) ===
# Terminal-level animated cursor trail (Neovide-like), rendered locally by the
# GPU — so it works in the shell, any TUI, AND over SSH. Replaces the in-nvim
# smear-cursor.nvim plugin (now disabled when running in Ghostty).
# Path is relative to this config file. Tune the trail in the shader's
# CONFIGURATION block (DURATION / TRAIL_SIZE) at the top of the .glsl.
custom-shader = shaders/cursor_warp.glsl
# `true` animates only while the cursor is moving (battery-friendly). If the
# trail ever looks choppy or doesn't animate, change this to `always`.
custom-shader-animation = true
